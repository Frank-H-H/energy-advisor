{
    "env": {
        "node": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
    },
    "globals": {
        "RED": "readonly"
    },
    "rules": {
        "no-unused-vars": ["warn"],
        "no-undef": "error"
    },
    "overrides": [{
            "files": ["tests//*.js"],
            "globals": {
                "describe": "readonly",
                "it": "readonly",
                "test": "readonly",
                "expect": "readonly",
                "beforeEach": "readonly",
                "afterEach": "readonly",
                "afterAll": "readonly",
                "beforeAll": "readonly"
            }
        }, {
            "files": ["nodes//*.js"],
            "globals": {
                "RED": "readonly"
            }
        }
    ]
}
