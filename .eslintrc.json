{
    "env": {
        "node": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
    },
    "globals": {
        "RED": "readonly"
    },
    "rules": {
        "no-unused-vars": ["warn"],
        "no-undef": "error"
    },
    "overrides": [{
            "files": ["tests//*.js"],
            "env": {
                "vitest": true
            }
        }, {
            "files": ["nodes//*.js"],
            "rules": {
                "no-undef": ["error", {
                        "typeof": true
                    }
                ]
            }
        }
    ]
}
